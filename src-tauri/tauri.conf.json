{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni",
  "version": "0.1.0",
  "identifier": "com.benner.mediaviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omni",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov"],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer"
      },
      {
        "ext": ["jpg", "jpeg", "png", "gif", "webp", "bmp", "heic"],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  }
}
