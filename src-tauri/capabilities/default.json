{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "cli:default",
    "core:window:allow-set-focus",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "ms-settings:defaultapps" }]
    }
  ]
}
